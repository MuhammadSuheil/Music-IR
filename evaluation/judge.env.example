# Optional callable instruction model for unattended whole-pool labeling.
# The retrieval encoder BGE-M3 cannot replace an instruction LLM.
# Configure these in the process environment; never commit real keys.
MUSIC_IR_JUDGE_PROVIDER=ollama
MUSIC_IR_JUDGE_BASE_URL=http://127.0.0.1:11434
MUSIC_IR_JUDGE_MODEL=replace-with-installed-instruction-model
MUSIC_IR_JUDGE_API_KEY=
MUSIC_IR_JUDGE_TIMEOUT=180
MUSIC_IR_JUDGE_RETRIES=2
MUSIC_IR_JUDGE_CONTEXT_CHARS=16000
MUSIC_IR_JUDGE_MAX_OUTPUT_TOKENS=1200
# OpenAI-compatible alternative:
# MUSIC_IR_JUDGE_PROVIDER=openai-compatible
# MUSIC_IR_JUDGE_BASE_URL=http://127.0.0.1:1234/v1
# MUSIC_IR_JUDGE_MODEL=actual-served-model-id
